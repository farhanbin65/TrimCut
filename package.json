{
  "name": "trimcut",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && npm run prepare:ffmpeg && vite build",
    "test": "node --test tests/*.test.ts",
    "desktop": "electron electron/main.cjs",
    "server": "node server/index.js",
    "prepare:ffmpeg": "node scripts/copy-ffmpeg.js",
    "typecheck": "tsc --noEmit",
    "predev": "npm run prepare:ffmpeg"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "express": "^4.21.2",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@types/prop-types": "^15.7.15",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "electron": "^35.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.1.0",
    "@types/node": "22.20.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
